{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/assets/:path*",
      "destination": "/dist/assets/:path*"
    },
    {
      "source": "/(index.html)?",
      "destination": "/dist/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/dist/:path*"
    }
  ]
}
